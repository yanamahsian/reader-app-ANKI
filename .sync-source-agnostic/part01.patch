+// ---------------------------------------------------------------------------
+// Fallback identity resolution (new).
+//
+// The QID mining above only works when master_corpus_candidates already has a workQid for a
+// given work -- i.e. when the separate master-corpus/Wikisource author-discovery pipeline has
+// already run successfully for that author. When it hasn't (a brand-new author onboarding, or
+// an author whose whole-oeuvre discovery pass failed/was never run -- e.g. it got rate-limited
+// by Wikidata mid-scan, as observed live against production for "tolstoy"), a work with a known
+// original_language can still recover its QID here, scoped to just that one work rather than the
+// author's entire bibliography: find the author's page on that one Wikisource language edition,
+// list the literary works linked from it, keep only ones with confirmed unambiguous non-deprecated
+// P50 authorship and an approved literary-work Wikidata type, then title-match that short list
+// against the target work's title/original_title/alternative_titles. Exactly one match -> use it.
+// Zero or multiple matches -> leave unresolved; this NEVER auto-attaches an ambiguous identity.
+//
+// Reuses the exact same MediaWiki/Wikidata call shapes and confirmedAuthorship/type rules already
+// proven in production by omnia-wikisource-discover-author, including its 429-aware retry/backoff
+// (the same rate limiting that failed a live discovery run for this author minutes before this
+// fix was written) -- not reinvented from scratch.
+// ---------------------------------------------------------------------------
+
+const AUTHOR_NAMESPACE = 102;
+const TYPE_CLOSURE_DEPTH = 3;
+const MAX_LINKED_PAGES = 180;
+const ROOT_LITERARY_WORK_TYPES = new Set(["Q571", "Q7725634", "Q25379"]); // book, literary work, play
+
+function sleep(ms: number) {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+async function fetchJsonWithRetry(url: string, label: string) {
+  for (let attempt = 0; attempt < 4; attempt++) {
+    const r = await fetch(url, { headers: { "User-Agent": "OmniaLibrary/1.0 (book ingestion; anki-multilingual-discover fallback identity)" } });
+    if (r.status === 429) {
+      const retryAfter = Math.min(5000, Math.max(750, Number(r.headers.get("retry-after") ?? "1") * 1000));
+      await sleep(retryAfter * (attempt + 1));
+      continue;
+    }
+    if (!r.ok) throw new Error(`${label} ${r.status}`);
+    const j = await r.json();
+    if (j?.error) {
+      if (j.error.code === "ratelimited") { await sleep(1000 * (attempt + 1)); continue; }
+      throw new Error(`${label} error: ${j.error.code ?? "unknown"}`);
+    }
+    return j;
+  }
+  throw new Error(`${label} rate-limited after retries`);
+}
+
+async function wikisourceQuery(wikiLanguage: string, params: Record<string, string>) {
+  const u = new URL(`https://${wikiLanguage}.wikisource.org/w/api.php`);
+  for (const [k, v] of Object.entries({ action: "query", format: "json", formatversion: "2", origin: "*", maxlag: "5", ...params })) u.searchParams.set(k, v);
+  const j = await fetchJsonWithRetry(u.toString(), "Wikisource API");
+  await sleep(180);
+  return j;
+}
+
+async function fetchWikidataClaims(ids: string[]) {
+  if (!ids.length) return {};
+  const u = new URL("https://www.wikidata.org/w/api.php");
+  for (const [k, v] of Object.entries({ action: "wbgetentities", format: "json", ids: ids.join("|"), props: "claims", origin: "*", maxlag: "5" })) u.searchParams.set(k, v);
+  const j = await fetchJsonWithRetry(u.toString(), "Wikidata API");
+  await sleep(180);
+  return j.entities ?? {};
+}
+
+function claimIds(entity: any, property: string): string[] {
+  const out: string[] = [];
+  for (const claim of entity?.claims?.[property] ?? []) {
+    const id = claim?.mainsnak?.datavalue?.value?.id;
+    if (typeof id === "string") out.push(id);
+  }
+  return out;
+}
+
+function confirmedAuthorship(entity: any, authorQid: string): boolean {
+  const claims = (entity?.claims?.P50 ?? []).filter((c: any) => c?.rank !== "deprecated" && c?.mainsnak?.snaktype === "value");
+  if (claims.length !== 1) return false;
+  const claim = claims[0];
+  const id = claim?.mainsnak?.datavalue?.value?.id;
+  if (id !== authorQid) return false;
+  const qualifiers = claim?.qualifiers ?? {};
+  if ((qualifiers.P1480?.length ?? 0) > 0 || (qualifiers.P2241?.length ?? 0) > 0) return false;
+  return true;
+}
+
+async function findWikisourceAuthorPage(wikiLanguage: string, names: string[]): Promise<{ title: string; qid: string } | null> {
+  for (const name of names.slice(0, 8)) {
+    const search = await wikisourceQuery(wikiLanguage, { list: "search", srsearch: name, srnamespace: String(AUTHOR_NAMESPACE), srlimit: "5" });
+    for (const hit of search?.query?.search ?? []) {
+      const props = await wikisourceQuery(wikiLanguage, { prop: "pageprops", titles: hit.title, redirects: "1" });
+      const page = props?.query?.pages?.[0];
+      const qid = page?.pageprops?.wikibase_item;
+      if (page && !page.missing && typeof qid === "string") return { title: page.title, qid };
+    }
+  }
+  return null;
+}
+
+async function fetchLinkedPageQids(wikiLanguage: string, authorPageTitle: string): Promise<Array<{ title: string; qid: string }>> {
+  const out: Array<{ title: string; qid: string }> = [];
+  let cont: Record<string, string> | null = null;
+  do {
+    const params: Record<string, string> = { generator: "links", titles: authorPageTitle, gplnamespace: "0", gpllimit: "50", prop: "pageprops", redirects: "1" };
+    if (cont) Object.assign(params, cont);
