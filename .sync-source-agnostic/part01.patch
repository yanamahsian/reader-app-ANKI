+// Built from character codes rather than a \uXXXX literal in the regex source -- deploy
+// tooling in this environment has been observed to silently decode \uXXXX escape sequences
+// into their literal Unicode character during transport, corrupting the regex. This
+// constructs the same [U+0300-U+036F] combining-marks range without that literal text ever
+// appearing in the source.
+const COMBINING_MARKS_PATTERN = new RegExp(`[${String.fromCharCode(0x0300)}-${String.fromCharCode(0x036f)}]`, "g");
+
+// Built from character codes rather than literal Latin-Extended/Cyrillic/CJK/Hiragana/Katakana
+// characters in the regex source -- a hand-transcribed multi-script literal in a very long
+// single-line deploy payload was observed to drift by a few code points in transit (the CJK
+// range's upper bound landed as U+9FEF instead of the intended U+9FAF on one deploy of this
+// exact file). Constructing every range from numeric code points removes that transcription
+// risk entirely, the same way NON_BREAKING_SPACE/COMBINING_MARKS_PATTERN already do above.
+const LATIN_EXTENDED_PATTERN = new RegExp(`[A-Za-z${String.fromCharCode(0x00c0)}-${String.fromCharCode(0x017e)}]`, "u");
+const NON_LATIN_AUTHOR_NAME_PATTERN = new RegExp(
+  `[${String.fromCharCode(0x0410)}-${String.fromCharCode(0x042f)}${String.fromCharCode(0x0430)}-${String.fromCharCode(0x044f)}${String.fromCharCode(0x0401)}${String.fromCharCode(0x0451)}${String.fromCharCode(0x4e00)}-${String.fromCharCode(0x9faf)}${String.fromCharCode(0x3041)}-${String.fromCharCode(0x309f)}${String.fromCharCode(0x30a0)}-${String.fromCharCode(0x30ff)}]`,
+  "u"
+);
+
+const CYRILLIC_YO_LOWER = String.fromCharCode(0x0451);
+const CYRILLIC_YE_LOWER = String.fromCharCode(0x0435);
+
 function normalize(value: string) {
-  return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase()
-    .replaceAll("ё", "е").replaceAll("&", " and ")
+  return value.normalize("NFD").replace(COMBINING_MARKS_PATTERN, "").toLowerCase()
+    .split(CYRILLIC_YO_LOWER).join(CYRILLIC_YE_LOWER).replaceAll("&", " and ")
     .replace(/[^\p{L}\p{N}]+/gu, " ").trim().replace(/\s+/g, " ");
 }
 
