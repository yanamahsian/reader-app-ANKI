+async function confirmedLiteraryWorkQids(entities: Record<string, any>): Promise<Set<string>> {
+  const good = new Set<string>(ROOT_LITERARY_WORK_TYPES);
+  const typesByQid = new Map<string, string[]>();
+  let frontier = new Set<string>();
+  for (const [qid, entity] of Object.entries(entities)) {
+    const types = claimIds(entity, "P31");
+    typesByQid.set(qid, types);
+    types.forEach(t => frontier.add(t));
+  }
+  const seen = new Set<string>();
+  for (let depth = 0; depth < TYPE_CLOSURE_DEPTH && frontier.size; depth++) {
+    const ids = Array.from(frontier).filter(id => !seen.has(id));
+    ids.forEach(id => seen.add(id));
+    const next = new Set<string>();
+    for (let i = 0; i < ids.length; i += 40) {
+      const chunkEntities = await fetchWikidataClaims(ids.slice(i, i + 40));
+      for (const [id, entity] of Object.entries(chunkEntities)) {
+        const parents = claimIds(entity, "P279");
+        if (parents.some(p => good.has(p))) good.add(id);
+        else parents.forEach(p => next.add(p));
+      }
+    }
+    frontier = next;
+  }
+  const confirmed = new Set<string>();
+  for (const [qid, types] of typesByQid) if (types.some(t => good.has(t))) confirmed.add(qid);
+  return confirmed;
+}
