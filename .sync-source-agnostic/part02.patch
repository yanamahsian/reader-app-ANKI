+// Resolves QIDs for works whose QID is still unknown after the master_corpus_candidates mining
+// above, one author-language pass at a time (works sharing a wikiLanguage share the author-page
+// lookup and linked-page scan). Returns a map of workId -> {qid, reason} for high-confidence
+// single matches only, plus a list of the works it looked at but could not confidently resolve
+// (for visibility in the response -- these are exactly the ones that should surface in review).
+async function resolveFallbackQids(
+  worksNeedingQid: WorkRow[],
+  knownNames: string[]
+): Promise<{ resolved: Map<string, { qid: string; authorPage: string; matchedTitle: string }>; unresolved: Array<{ workId: string; reason: string }> }> {
+  const resolved = new Map<string, { qid: string; authorPage: string; matchedTitle: string }>();
+  const unresolved: Array<{ workId: string; reason: string }> = [];
+
+  const byLanguage = new Map<string, WorkRow[]>();
+  for (const work of worksNeedingQid) {
+    if (!work.original_language) { unresolved.push({ workId: work.id, reason: "original_language is unknown; cannot pick a Wikisource language edition to search" }); continue; }
+    const list = byLanguage.get(work.original_language) ?? [];
+    list.push(work);
+    byLanguage.set(work.original_language, list);
+  }
+
+  for (const [wikiLanguage, works] of byLanguage) {
+    let authorPage: { title: string; qid: string } | null;
+    try {
+      authorPage = await findWikisourceAuthorPage(wikiLanguage, knownNames);
+    } catch (error) {
+      const reason = `Wikisource author-page lookup failed: ${error instanceof Error ? error.message : String(error)}`;
+      for (const work of works) unresolved.push({ workId: work.id, reason });
+      continue;
+    }
+    if (!authorPage) {
+      for (const work of works) unresolved.push({ workId: work.id, reason: `No ${wikiLanguage}.wikisource.org Author-namespace page found for this author` });
+      continue;
+    }
+
+    let linked: Array<{ title: string; qid: string }>;
+    try {
+      linked = await fetchLinkedPageQids(wikiLanguage, authorPage.title);
+    } catch (error) {
+      const reason = `Wikisource linked-pages lookup failed: ${error instanceof Error ? error.message : String(error)}`;
+      for (const work of works) unresolved.push({ workId: work.id, reason });
+      continue;
+    }
+
+    let entities: Record<string, any> = {};
+    try {
+      for (let i = 0; i < linked.length; i += 40) Object.assign(entities, await fetchWikidataClaims(linked.slice(i, i + 40).map(x => x.qid)));
+    } catch (error) {
+      const reason = `Wikidata entity fetch failed: ${error instanceof Error ? error.message : String(error)}`;
+      for (const work of works) unresolved.push({ workId: work.id, reason });
+      continue;
+    }
+
+    let confirmedQids: Set<string>;
+    try {
+      confirmedQids = await confirmedLiteraryWorkQids(entities);
+    } catch (error) {
+      const reason = `Wikidata type-classification failed: ${error instanceof Error ? error.message : String(error)}`;
+      for (const work of works) unresolved.push({ workId: work.id, reason });
+      continue;
+    }
+
+    const approved = linked.filter(link => confirmedQids.has(link.qid) && confirmedAuthorship(entities[link.qid], authorPage!.qid));
+
+    for (const work of works) {
+      const variants = titleVariants(work.title);
+      addTitleVariantsFrom(variants, work.original_title);
+      for (const alt of work.alternative_titles ?? []) addTitleVariantsFrom(variants, alt);
+
+      const matches = approved.filter(link => Array.from(titleVariants(link.title)).some(v => variants.has(v)));
+      if (matches.length === 1) {
+        resolved.set(work.id, { qid: matches[0].qid, authorPage: authorPage.title, matchedTitle: matches[0].title });
+      } else if (matches.length === 0) {
+        unresolved.push({ workId: work.id, reason: `No confirmed literary-work page linked from ${wikiLanguage}.wikisource.org's "${authorPage.title}" matched this work's title` });
+      } else {
+        unresolved.push({ workId: work.id, reason: `${matches.length} confirmed literary-work pages matched this work's title -- ambiguous, left for manual review` });
+      }
+    }
+  }
+
+  return { resolved, unresolved };
+}
+
+function addTitleVariantsFrom(target: Set<string>, value: string | null | undefined) {
+  if (!value) return;
+  for (const variant of titleVariants(value)) target.add(variant);
+}
