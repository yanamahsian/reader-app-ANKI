+/* =========================================================
+   APP SHELL / GLOBAL BACKGROUND / GLOBAL HEADER
+   New app-wide frame (src/app/AppShell.tsx and friends) — mounted once
+   around every non-Reader screen (App.tsx renders <ReaderView/> alone,
+   with none of this, when the reader is open). GlobalBackground is a
+   single fixed hero photo behind the whole app; GlobalHeader is a
+   single persistent nav bar on top of it. Neither remounts as the
+   visitor navigates between Home/Library/Collections/Book Detail/
+   Author Detail/the account shells — only .app-shell-content's
+   children swap underneath them.
+   ========================================================= */
+
+.app-shell {
+  position: relative;
+  min-height: 100vh;
+}
+
+.app-shell-content {
+  position: relative;
+  min-height: 100vh;
+}
+
+.global-bg {
+  position: fixed;
+  inset: 0;
+
+  /* Negative z-index keeps this behind ordinary in-flow content
+     without needing every page section to opt into its own stacking
+     context — see the comment on .app-shell-content above: nothing in
+     this file gives .app-shell/.app-shell-content a transform, which
+     would otherwise re-anchor this fixed element to that ancestor
+     instead of the viewport. */
+  z-index: -1;
+}
+
+.global-bg-image {
+  position: absolute;
+  inset: 0;
+
+  background-position: center;
+  background-size: cover;
+
+  animation: global-bg-reveal 1.4s ease both;
+}
+
+.global-bg-shade {
+  position: absolute;
+  inset: 0;
+
+  background:
+    linear-gradient(
+      180deg,
+      rgba(10, 6, 5, 0.5) 0%,
+      rgba(10, 6, 5, 0.68) 55%,
+      rgba(10, 6, 5, 0.92) 100%
+    ),
+    linear-gradient(
+      90deg,
+      rgba(10, 6, 5, 0.32) 0%,
+      transparent 40%,
+      rgba(10, 6, 5, 0.32) 100%
+    );
+}
+
+@keyframes global-bg-reveal {
+  from {
+    opacity: 0;
+    transform: scale(1.02);
+  }
+  to {
+    opacity: 1;
+    transform: scale(1);
+  }
+}
+
+.global-header {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+
+  z-index: 500;
+
+  height: 64px;
+
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+
+  padding: 0 7.5%;
+
+  background: linear-gradient(180deg, rgba(9, 6, 5, 0.7), rgba(9, 6, 5, 0));
+
+  backdrop-filter: blur(6px);
+  -webkit-backdrop-filter: blur(6px);
+}
+
+.global-header-brand {
+  border: 0;
+  background: transparent;
+  color: var(--home-text);
+
+  font-family: "Cormorant Garamond", serif;
+  font-size: 20px;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+
+  cursor: pointer;
+}
+
+.global-header-brand span {
+  color: var(--home-gold);
+}
+
+.global-header-nav {
+  display: flex;
+  align-items: center;
+  gap: 36px;
+}
+
+.global-header-nav button {
+  border: 0;
+  background: transparent;
+  color: rgba(241, 231, 216, 0.78);
+
+  font-size: 11px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.global-header-nav button:hover {
+  color: var(--home-gold);
+}
+
