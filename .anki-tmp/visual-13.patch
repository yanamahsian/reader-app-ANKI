+.global-header-actions {
+  display: flex;
+  align-items: center;
+  gap: 20px;
+}
+
+.global-header-lang {
+  color: rgba(241, 231, 216, 0.5);
+
+  font-size: 10px;
+  letter-spacing: 0.14em;
+}
+
+.global-header-account {
+  width: 36px;
+  height: 36px;
+
+  display: grid;
+  place-items: center;
+
+  border: 1px solid rgba(202, 160, 88, 0.34);
+  border-radius: 50%;
+
+  background: rgba(16, 10, 8, 0.4);
+  color: var(--home-text);
+
+  font-size: 14px;
+}
+
+.global-header-account:hover,
+.global-header-account[aria-expanded="true"] {
+  border-color: var(--home-gold);
+  background: rgba(74, 21, 29, 0.6);
+}
+
+.global-header-mobile-nav {
+  display: none;
+}
