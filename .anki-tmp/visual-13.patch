+/* =========================================================
+   ACCOUNT MENU
+   ========================================================= */
+
+.account-menu-backdrop {
+  position: fixed;
+  inset: 0;
+
+  z-index: 1500;
+
+  background: rgba(0, 0, 0, 0.4);
+}
+
+.account-menu {
+  position: fixed;
+  top: 72px;
+  right: 7.5%;
+
+  z-index: 1501;
+
+  width: min(300px, calc(100vw - 40px));
+
+  padding: 22px;
+
+  background: #17100d;
+  border: 1px solid var(--home-border);
+
+  box-shadow: 0 18px 46px rgba(0, 0, 0, 0.5);
+}
+
+.account-menu-guest {
+  padding-bottom: 18px;
+  margin-bottom: 14px;
+
+  border-bottom: 1px solid var(--home-border);
+}
+
+.account-menu-guest p {
+  margin: 0 0 14px;
+
+  color: var(--home-muted);
+
+  font-size: 12px;
+  letter-spacing: 0.03em;
+}
+
+.account-menu-guest-actions {
+  display: flex;
+  align-items: center;
+  gap: 18px;
+}
+
+.account-menu-guest-actions .primary-button {
+  min-height: 38px;
+  padding: 8px 16px;
+}
+
+.account-menu-list {
+  display: flex;
+  flex-direction: column;
+}
+
+.account-menu-list button {
+  padding: 12px 2px;
+
+  border: 0;
+  border-bottom: 1px solid var(--home-border);
+
+  background: transparent;
+  color: var(--home-text);
+
+  font-size: 13px;
+  letter-spacing: 0.02em;
+  text-align: left;
+}
+
+.account-menu-list button:last-child {
+  border-bottom: 0;
+}
+
+.account-menu-list button:hover {
+  color: var(--home-gold);
+}
+
+
+/* =========================================================
+   COVER FALLBACK / BOOK GRID / LIBRARY BOOK CARD
+   Shared by Library, Author Detail's works list, and Collection
+   Detail (see src/features/shared/{CoverFallback,BookGrid,
+   LibraryBookCard}.tsx) — one visual system for "a book tile", so all
+   three screens read as the same catalog rather than three redesigns.
+   ========================================================= */
+
+.book-grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 30px 20px;
+}
+
+@media (min-width: 620px) {
+  .book-grid {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+@media (min-width: 900px) {
+  .book-grid {
+    grid-template-columns: repeat(4, 1fr);
+  }
+}
+
+@media (min-width: 1200px) {
+  .book-grid {
+    grid-template-columns: repeat(5, 1fr);
+  }
+}
+
+@media (min-width: 1600px) {
+  .book-grid {
+    grid-template-columns: repeat(6, 1fr);
+  }
+}
+
+.library-book-card {
+  cursor: pointer;
+}
+
+.library-book-cover,
+.book-detail-cover {
+  position: relative;
+
+  aspect-ratio: 2 / 3;
+
+  overflow: hidden;
+
+  background: var(--home-surface-soft);
+  border: 1px solid var(--home-border);
+}
+
+.library-book-cover img,
+.book-detail-cover img {
+  width: 100%;
+  height: 100%;
+
+  object-fit: cover;
+  display: block;
+}
+
+.library-book-title {
+  margin: 14px 0 4px;
+
+  font-family: "Cormorant Garamond", serif;
+  font-size: 17px;
+  line-height: 1.22;
+
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+.library-book-author {
+  color: var(--home-muted);
+
+  font-size: 11px;
+  letter-spacing: 0.02em;
+}
+
+/* Same dark burgundy/gold-frame formula wherever a real cover is
+   missing — deliberately not a gray placeholder or a bright gradient
+   tile (see the component's own comment for the full reasoning). */
+.cover-fallback {
+  position: relative;
+
+  width: 100%;
+  height: 100%;
+
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 16px;
+
+  background:
+    radial-gradient(circle at 30% 18%, rgba(202, 160, 88, 0.14), transparent 55%),
+    linear-gradient(160deg, #2a1116 0%, #150d0a 70%);
+
+  outline: 1px solid rgba(202, 160, 88, 0.32);
+  outline-offset: -8px;
+}
+
+.cover-fallback-rule {
+  width: 22px;
+  height: 1px;
+
+  background: rgba(202, 160, 88, 0.55);
+}
+
+.cover-fallback-monogram {
+  font-family: "Cormorant Garamond", serif;
+  font-size: 32px;
+  color: var(--home-gold);
+}
+
